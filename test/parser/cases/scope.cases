#
# Section "otel-scope": the rules the generated shapes cannot express -- name
# uniqueness within one line, keywords across two scopes, and the pairings
# checked once the section has been parsed.
#

@case scope-dup-name
@kw scope:otel-scope
@tmpl whole
@want err
@match already defined
@body
[parser]
    otel-instrumentation parser-instr
        config @YML@
        scopes parser-scope

    otel-scope parser-scope
        otel-event on-frontend-http-request

    otel-scope parser-scope
        otel-event on-http-end-request
@end

@case scope-name-reuse-toplevel-ok
@kw scope:otel-scope
@tmpl whole
@want ok
@body
[parser]
    otel-instrumentation parser-instr
        config @YML@
        scopes parser-scope

    otel-scope parser-scope
        otel-event on-frontend-http-request

[other]
    otel-scope parser-scope
        otel-event on-http-end-request
@end

@case scope-bad-name
@kw scope:otel-scope
@tmpl whole
@want err
@match invalid character '!'
@body
[parser]
    otel-instrumentation parser-instr
        config @YML@
        scopes parser-scope

    otel-scope bad!name
        otel-event on-frontend-http-request
@end

