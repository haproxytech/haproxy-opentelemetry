        otel-event on-frontend-http-request
@end

@case scope-acl-other-scope
@kw scope:acl
@tmpl whole
@want err
@match no such ACL
@body
[parser]
    otel-instrumentation parser-instr
        config @YML@
        scopes parser-scope
        scopes parser-scope-2

    otel-scope parser-scope
        acl s-x path_beg /x
        otel-stop if s-x
        otel-event on-frontend-http-request

    otel-scope parser-scope-2
        otel-stop if s-x
        otel-event on-http-end-request
@end

